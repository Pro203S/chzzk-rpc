{
    "manifest_version": 3,
    "name": "Discheese",
    "description": "치지직에서 보고 있는 방송을 디스코드에 자랑해보세요!",
    "version": "0.1.0",
    "permissions": ["tabs", "webNavigation", "storage"],
    "host_permissions": ["https://chzzk.naver.com/*"],
    "background": {
        "service_worker": "dist/assets/background.js",
        "type": "module"
    },
    "action": {
        "default_title": "Discheese",
        "default_popup": "dist/popup.html"
    }
}
