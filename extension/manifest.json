{
    "manifest_version": 3,
    "name": "Discheese",
    "description": "치지직에서 보고 있는 방송을 디스코드에 자랑해보세요!",
    "version": "1.0.0",
    "permissions": ["storage", "webNavigation"],
    "host_permissions": [
        "http://localhost/*",
        "https://chzzk.naver.com/*",
        "https://api.chzzk.naver.com/*"
    ],
    "icons": {
        "16": "dist/icons/icon16.png",
        "32": "dist/icons/icon32.png",
        "48": "dist/icons/icon48.png",
        "128": "dist/icons/icon128.png"
    },
    "background": {
        "service_worker": "dist/assets/background.js",
        "type": "module"
    },
    "action": {
        "default_title": "Discheese",
        "default_popup": "dist/popup.html",
        "default_icon": {
            "16": "dist/icons/icon16.png",
            "32": "dist/icons/icon32.png",
            "48": "dist/icons/icon48.png"
        }
    }
}
